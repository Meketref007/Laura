{
  "manifest_version": 3,
  "name": "Laura Companion",
  "version": "1.0.0",
  "description": "Monitoramento e controle do agente Laura para Shopee",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8888/*",
    "https://seller.shopee.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Laura Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://seller.shopee.com.br/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
