# =============================================================================
# Laura — Configuration File
# Copy to .env and fill in your values
# =============================================================================

# --- Shopee API (Obrigatório) ---
SHOPEE_PARTNER_ID=123456
SHOPEE_PARTNER_KEY_SHA256=seu_hash_sha256_aqui
SHOPEE_DEFAULT_ACCESS_TOKEN=seu_token_aqui
SHOPEE_DEFAULT_SHOP_ID=123456789
SHOPEE_COUNTRY=br

# --- LLM ---
# Local (padrão, gratuito): não precisa configurar nada
# Remoto (pago): descomente e configure abaixo
# LAURA_ALLOW_PAID_LLM=1
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234...

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8888
# DASHBOARD_API_KEY= (auto-gerada se vazia)

# --- Webhook ---
# WEBHOOK_SECRET=seu_secret
# CHAT_AUTO_RESPOND=0

# --- Redis ---
# REDIS_URL=redis://localhost:6379/0

# --- SMTP (Relatórios por email) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@email.com
# SMTP_PASS=sua_senha
# SMTP_FROM=laura@seudominio.com
# ALERT_EMAIL=admin@seudominio.com

# --- Paths (opcional — usa defaults relativos a reports/) ---
# LAURA_REPORTS_DIR=reports
# LAURA_LOGS_DIR=logs
# LAURA_DATA_DIR=data

# --- Locale ---
LAURA_LOCALE=pt_BR  # pt_BR ou en_US
